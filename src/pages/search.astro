---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="搜索" description="搜索个人技术思考博客中的文章" noindex={true}>
  <header class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold">搜索</h1>
    <p class="text-muted-foreground">只搜索文章正文，也可从首页标签带入关键词。</p>
  </header>

  <div id="search" class="w-full"></div>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      const PagefindUI = (window as any).PagefindUI;
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        excerptLength: 150,
        placeholder: "搜索文章...",
        resetStyles: false
      });

      const query = new URLSearchParams(window.location.search).get('q')?.trim();
      if (query) {
        const input = document.querySelector<HTMLInputElement>('#search .pagefind-ui__search-input');
        if (input) {
          input.value = query;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    });
  </script>
</Layout>
