---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const RECENT_POSTS_LIMIT = 6;
const posts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = posts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, RECENT_POSTS_LIMIT);

// 首页只展示至少被两篇文章使用的标签，完整标签仍可从文章页进入搜索。
const commonTags = Object.entries(
  posts.reduce((acc, post) => {
    if (post.data.tags) {
      post.data.tags.forEach(tag => {
        acc[tag] = (acc[tag] || 0) + 1;
      });
    }
    return acc;
  }, {} as Record<string, number>)
)
  .filter(([, count]) => count > 1)
  .sort(([tagA, countA], [tagB, countB]) => countB - countA || tagA.localeCompare(tagB, 'zh-CN'));
---

<Layout title="首页" description="玛卡巴子的个人技术博客，专注 C++、Qt 桌面开发、AI 编程工具实践与真实问题排查。">
  {/* Hero 区域 */}
  <section class="mb-12 relative">
    {/* 渐变光晕装饰 */}
    <div class="absolute -top-10 -right-10 w-64 h-64 rounded-full bg-gradient-radial from-[var(--tech-gradient-1)] to-transparent opacity-20 blur-2xl animate-pulse pointer-events-none"></div>
    <div class="absolute -bottom-10 -left-10 w-48 h-48 rounded-full bg-gradient-radial from-[var(--tech-gradient-2)] to-transparent opacity-20 blur-2xl animate-pulse animation-delay-2000 pointer-events-none"></div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center mb-10 relative z-10">
      <div class="md:col-span-1 flex justify-center">
        <img
          src="https://github.com/laoola.png"
          alt="玛卡巴子的 GitHub 头像"
          class="w-48 h-48 rounded-full border-4 border-border shadow-lg ring-2 ring-[var(--tech-gradient-1)]/20"
        />
      </div>
      <div class="md:col-span-2">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 tech-text-gradient">你好，我是玛卡巴子</h1>
        <p class="text-xl text-muted-foreground mb-6">
          专注 C++ / Qt 桌面开发、AI 编程工具实践与真实问题排查。
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="https://github.com/laoola"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 border border-border rounded-lg hover:bg-muted transition-colors tech-card-hover tech-interactive"
          >
            GitHub
          </a>
          <a href="/blog" class="px-4 py-2 border border-border rounded-lg hover:bg-muted transition-colors tech-card-hover tech-interactive">
            查看全部思考
          </a>
          <a href="/about" class="px-4 py-2 border border-border rounded-lg hover:bg-muted transition-colors tech-card-hover tech-interactive">
            关于我
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* 最新文章 */}
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6">最新思考</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {recentPosts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        return (
          <article class="p-6 border border-border rounded-lg tech-card-hover">
            <h3 class="text-xl font-semibold mb-2">
              <a href={`/blog/${slug}`} class="hover:text-primary transition-colors tech-interactive">
                {post.data.title}
              </a>
            </h3>
            <p class="text-muted-foreground text-sm mb-3">
              {new Date(post.data.date).toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </p>
            <p class="text-muted-foreground mb-4">{post.data.description}</p>
            {post.data.tags && (
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/search?q=${encodeURIComponent(tag)}`}
                    class="px-2 py-1 bg-muted rounded-full text-xs hover:bg-muted/80 transition-colors tech-interactive"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
    {posts.length > RECENT_POSTS_LIMIT && (
      <div class="mt-8 text-center">
        <a href="/blog" class="inline-block px-6 py-2 border border-border rounded-lg hover:bg-muted transition-colors tech-card-hover tech-interactive">
          查看全部 ({posts.length}) →
        </a>
      </div>
    )}
  </section>

  {/* 常用标签 */}
  {commonTags.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold mb-2">常用标签</h2>
      <p class="text-muted-foreground text-sm mb-6">按主题聚合文章，点击标签即可搜索。</p>
      <div class="flex flex-wrap gap-3">
        {commonTags.map(([tag, count]) => {
          const sizeClass = count > 3 ? 'text-base font-medium' : 'text-sm';
          return (
            <a
              href={`/search?q=${encodeURIComponent(tag)}`}
              class={`${sizeClass} px-4 py-2 bg-muted rounded-full hover:bg-muted/80 transition-colors tech-card-hover tech-interactive`}
            >
              {tag} ({count})
            </a>
          );
        })}
      </div>
    </section>
  )}
</Layout>
